# Bu dosyayı .env adıyla kopyala ve değerleri doldur. .env asla commit'lenmez.

# Tur jetonlarını şifreleyen 32 baytlık anahtar (base64). Üretmek için:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
QUIZ_TOKEN_KEY=

# Upstash Redis REST bilgileri (canlıda Vercel ortam değişkenlerinde durur).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Yerelde Redis yerine bellek içi depo kullanmak için 1.
QUIZ_DEV=1

# Yapay zekâ soru havuzu (lib/ai/). Anahtarlar sadece sunucuda okunur, tarayıcıya gitmez.
# Gemini soruyu yazar: https://aistudio.google.com/apikey · Groq doğrular: https://console.groq.com/keys
GEMINI_API_KEY=
GROQ_API_KEY=
# Vercel'in gece görevini (api/cron/refill.js) çağırırken gönderdiği gizli değer; en az 32 rastgele karakter.
CRON_SECRET=
# İsteğe bağlı: model zincirleri, sırayla denenir ("sağlayıcı:model", virgülle)
# AI_GENERATORS=gemini:gemini-3.8-flash,gemini:gemini-3.5-flash,gemini:gemini-3.1-flash-lite
# AI_VERIFIERS=groq:openai/gpt-oss-120b,groq:qwen/qwen3.8-27b,gemini:gemini-3.1-flash-lite

# Birlikte oynama sunucusu (live/server.js, npm run live). Yerelde geliştirme sunucusunun adresi.
LIVE_ORIGINS=http://localhost:5173
