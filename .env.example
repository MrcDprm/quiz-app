# Bu dosyayı .env adıyla kopyala ve değerleri doldur. .env asla commit'lenmez.

# Tur jetonlarını şifreleyen 32 baytlık anahtar (base64). Üretmek için:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
QUIZ_TOKEN_KEY=

# Upstash Redis REST bilgileri (canlıda Vercel ortam değişkenlerinde durur).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Yerelde Redis yerine bellek içi depo kullanmak için 1.
QUIZ_DEV=1
